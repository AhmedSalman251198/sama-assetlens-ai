{
  "name": "assetlens-ai",
  "version": "1.10.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.typecheck.json",
    "test:quality": "node --experimental-strip-types --test tests/*.test.mjs",
    "test": "npm run lint && npm run typecheck && npm run build && npm run test:quality",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "^16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "AssetLens AI",
  "overrides": {
    "uuid": "11.1.1",
    "esbuild": "0.28.2"
  }
}
